pkgname=gcp-calc-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Calculadora em notas: linguagem natural, moedas ao vivo, unidades e IA assistiva"
arch=('x86_64')
url="https://github.com/cliqueprojeto/GCP-Calc"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'openssl' 'hicolor-icon-theme')
optdepends=('polkit: instalar atualizações pelo próprio aplicativo')
provides=('gcp-calc')
conflicts=('gcp-calc')
options=('!strip' '!debug')
source=("gcp-calc_${pkgver}_amd64.deb")
sha256sums=('SKIP')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  chmod -R u=rwX,go=rX "$pkgdir/usr"
}
