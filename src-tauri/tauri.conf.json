{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GCP-Calc",
  "mainBinaryName": "gcp-calc",
  "version": "1.12.0",
  "identifier": "br.com.gestaoculturalpro.calc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GCP-Calc",
        "width": 1320,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "dmg", "app"],
    "publisher": "Bruno Albertini | Gestão Cultural Pro",
    "copyright": "© 2026 Bruno Albertini | Gestão Cultural Pro — GPL-3.0",
    "category": "Productivity",
    "shortDescription": "Calculadora em notas: cálculos em linguagem natural, moedas ao vivo e unidades.",
    "longDescription": "GCP-Calc é uma calculadora em notas: escreva cálculos em linguagem natural e veja os resultados na hora, com moedas e criptomoedas ao vivo, conversão de unidades, porcentagens, variáveis, datas, gráficos, assistente passo a passo com IA opcional e backup criptografado no Google Drive.",
    "homepage": "https://github.com/cliqueprojeto/GCP-Calc",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": {
        "section": "utils",
        "depends": []
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English", "Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
